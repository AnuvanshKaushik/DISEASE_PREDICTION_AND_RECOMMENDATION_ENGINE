{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://disease-prediction-and-recommendation.onrender.com/api/:path*"
    },
    {
      "source": "/src/:path*",
      "destination": "/client/src/:path*"
    },
    {
      "source": "/",
      "destination": "/client/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/client/:path*"
    }
  ]
}
